<Window x:Class="GtaAutoGameplay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GTA Auto Gameplay — Window Selection"
        Width="820"
        Height="560"
        MinWidth="640"
        MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock FontSize="26"
                 FontWeight="SemiBold"
                 Text="Window Selection" />
      <TextBlock Margin="0,8,0,0"
                 Foreground="#555555"
                 TextWrapping="Wrap"
                 Text="Developer Preview: selecting a window does not start capture, arm automation, or send input." />
    </StackPanel>

    <StackPanel Grid.Row="1"
                Margin="0,20,0,12"
                Orientation="Horizontal">
      <Button x:Name="RefreshButton"
              MinWidth="150"
              Padding="14,8"
              Click="RefreshButton_Click"
              Content="扫描/刷新窗口" />
      <Button x:Name="SelectButton"
              Margin="10,0,0,0"
              MinWidth="100"
              Padding="14,8"
              IsEnabled="False"
              Click="SelectButton_Click"
              Content="选择" />
      <Button x:Name="CancelSelectionButton"
              Margin="10,0,0,0"
              MinWidth="110"
              Padding="14,8"
              IsEnabled="False"
              Click="CancelSelectionButton_Click"
              Content="取消选择" />
    </StackPanel>

    <Border Grid.Row="2"
            BorderBrush="#C8C8C8"
            BorderThickness="1"
            CornerRadius="4">
      <ListBox x:Name="CandidateList"
               BorderThickness="0"
               SelectionChanged="CandidateList_SelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="90" />
              </Grid.ColumnDefinitions>
              <TextBlock Margin="0,0,12,0"
                         Text="{Binding Title}"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Title}" />
              <TextBlock Grid.Column="1"
                         Margin="0,0,12,0"
                         Text="{Binding ProcessName}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2"
                         Text="{Binding ProcessId, StringFormat=PID {0}}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <TextBlock x:Name="ScanStatusText"
               Grid.Row="3"
               Margin="0,12,0,0"
               Foreground="#555555"
               Text="尚未扫描窗口。"
               TextWrapping="Wrap" />

    <Border Grid.Row="4"
            Margin="0,12,0,0"
            Padding="12"
            Background="#F3F5F7"
            CornerRadius="4">
      <StackPanel>
        <TextBlock FontWeight="SemiBold"
                   Text="当前选择" />
        <TextBlock x:Name="CurrentSelectionText"
                   Margin="0,4,0,0"
                   Text="未选择窗口"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
