<Window x:Class="GtaAutoGameplay.ControlledWindow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GTA Auto Gameplay Controlled Window — M1-A Test"
        Width="620"
        Height="360"
        MinWidth="520"
        MinHeight="300"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="32">
    <StackPanel VerticalAlignment="Center">
      <TextBlock HorizontalAlignment="Center"
                 FontSize="26"
                 FontWeight="SemiBold"
                 Text="M1-A Controlled Test Window" />
      <TextBlock Margin="0,16,0,0"
                 HorizontalAlignment="Center"
                 FontSize="16"
                 Text="This independent window is only for explicit discovery and selection tests." />
      <TextBlock Margin="0,10,0,0"
                 HorizontalAlignment="Center"
                 Foreground="#555555"
                 Text="It does not capture content, send input, imitate GTA, or enter release artifacts."
                 TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Window>
